              setIsUploadOpen(true);
            }}
            onUpdateTrack={handleUpdateTrack}
            onSwitchToAdmin={() => { setIsAdminOpen(false); setIsProfileOpen(true); }}
            onCategoriesUpdated={fetchCategories}
          />
          </Suspense>}
    
