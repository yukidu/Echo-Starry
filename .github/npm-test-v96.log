            onClose={() => {
              setIsUploadOpen(false);
              setTrackToEdit(null);
            }}
            currentUser={currentUser}
            isAdmin={isAdmin}
            trackToEdit={trackToEdit}
            tracks={tracks}
            onCategoriesUpdated={fetchCategories}
