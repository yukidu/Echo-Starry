                setTrackToEdit(null);
              } else {
                locallyChangedTrackIds.current.add(normalizedTrack.id);
                setTracks(prev => [normalizedTrack, ...prev]);
                handlePlayTrack(normalizedTrack, savedPreferredMode);
              }
            }}
          />
